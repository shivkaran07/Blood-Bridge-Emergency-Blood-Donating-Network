# ---------------------------------------------------------------------------
# BloodBridge backend environment (copy to .env and fill in real values)
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP server
PORT=4000
NODE_ENV=development
# Express "trust proxy" setting. Set to "true" only behind a trusted reverse proxy.
TRUST_PROXY=false

# Comma-separated list of allowed browser origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service-role key. SERVER ONLY. Bypasses RLS, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL connection string for the Supabase database.
# Dashboard -> Project Settings -> Database -> Connection string (URI).
# Prefer the session pooler / direct connection for migrations.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Set to "true" when the connection requires TLS (Supabase hosted databases do).
DATABASE_SSL=true

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
WRITE_RATE_LIMIT_MAX=60

# Required in production for shared rate limits; omit locally to use memory storage.
REDIS_URL=

# ---------------------------------------------------------------------------
# Distributed rate-limit store (production requirement for multi-instance API)
# ---------------------------------------------------------------------------
# By default express-rate-limit uses an in-process memory store. This is safe
# for a single-instance development server but does NOT coordinate limits
# across multiple API replicas. In a multi-instance production deployment you
# MUST provide a shared Redis store.
#
# Redis client and store are included in backend dependencies.
# Set REDIS_URL to your Redis-compatible service connection string.
#
# Leave REDIS_URL unset (or empty) for local development; the memory store
# will be used. Do NOT invent a Redis URL or use a production Redis instance
# without proper access control and TLS.
#
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=rediss://user:password@redis.example.com:6379   # TLS variant

# Optional transactional email (Resend). Email alerts are opt-in per account.
# When configured, messages contain no request, donor, or health details.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:5173

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Blockchain (Part 2)
# ---------------------------------------------------------------------------
# The app is ON_CHAIN only when BLOCKCHAIN_ENABLED=true AND an actual deployed
# contract address is set; otherwise verification stays database-backed.
# `npm run contracts:deploy` fills BLOCKCHAIN_CONTRACT_ADDRESS automatically.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK_NAME=hardhat-local
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=

# Wallet-ownership challenge lifetime (seconds)
BLOCKCHAIN_WALLET_CHALLENGE_TTL_SECONDS=300
# Blocks to wait behind an anchor transaction before it is trusted
BLOCKCHAIN_CONFIRMATIONS=1
# Max wait time for a wallet transaction receipt (ms)
BLOCKCHAIN_RECEIPT_TIMEOUT_MS=120000
