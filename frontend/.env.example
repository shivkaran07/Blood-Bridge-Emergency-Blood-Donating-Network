# ---------------------------------------------------------------------------
# BloodBridge frontend environment (copy to .env and fill in real values)
# Vite only exposes variables prefixed with VITE_. Everything here is PUBLIC.
# NEVER put a Supabase service-role key in this file.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the publishable key (or legacy anon key) from Supabase Dashboard -> API.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_API_BASE_URL=http://localhost:4000/api/v1
